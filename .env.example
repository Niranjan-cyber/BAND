# Copy to .env (never commit .env). Every variable the app reads must be listed here with a comment.
# Values here are placeholders. Real values come from the pipeline / secret store.

# --- LLM adapter (see assets/llm-adapter) ---
LLM_PROVIDER=echo          # echo | anthropic | openai-compatible
LLM_MODEL=                 # provider's model id; check current docs
LLM_API_KEY=               # backend only; never expose to the frontend
LLM_BASE_URL=              # required for openai-compatible
LLM_TIMEOUT_MS=30000

# --- Backend ---
ALLOWED_ORIGINS=http://localhost:5173   # CORS allow-list; not needed in prod while same-origin (see below)
APP_MODE=live                            # surfaced by GET /health

# --- Frontend ---
# Currently same-origin: FastAPI serves frontend/dist/ directly (see backend/main.py), so the
# frontend calls relative paths like /health and needs no base-URL env var.
# If Pocketful later needs a split frontend/backend deploy, reintroduce this (set from pipeline
# outputs, never typed by hand in production) and update RUNBOOK.md + the CI workflow:
# VITE_API_BASE_URL=http://localhost:8000
